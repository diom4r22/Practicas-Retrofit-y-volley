<?xml version="1.0" encoding="utf-8"?>

<!-- Este es el diseno de UNA tarjeta de la lista.
     El adaptador lo repite por cada Pokemon que llega de la API. -->

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:contentPadding="16dp">

    <!-- Vertical para que el nombre quede encima de la url -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Nombre del Pokemon -->
        <TextView
            android:id="@+id/tvPokemonName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Url del Pokemon. Con maxLines y ellipsize se corta
             con puntos suspensivos si no cabe en una linea. -->
        <TextView
            android:id="@+id/tvPokemonUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
